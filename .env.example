# Optional: your own exported Netscape-format cookie files.
# Do not commit real cookies.
DOUYIN_COOKIE_FILE=
BILIBILI_COOKIE_FILE=
SOCIAL_COLLECTOR_COOKIE_FILE=

# Optional: your own Douyin browser session cookie string for the detail API path.
DOUYIN_COOKIE=

# Optional custom OpenCLI executable path.
OPENCLI_BIN=

# Optional Feishu Bitable integration. Never commit real app secrets.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional: use an existing Bitable base. If empty, `feishu setup` tries to create one.
FEISHU_BITABLE_APP_TOKEN=

# Optional target folder when creating a new Bitable base.
FEISHU_FOLDER_TOKEN=

# Local non-secret resource ids/state.
FEISHU_STATE_FILE=data/feishu.json
